# WMVAA Akademia - HOSTING/PRODUCTION ONLY
#
# Upload this template, copy it to the application root as `.env`, then replace
# every CHANGE_ME value on the hosting server. Never overwrite it with the
# local-development `.env` and never commit the populated production file.
CI_ENVIRONMENT = production

# Keep the trailing slash. If the hosting document root points directly to this
# application, use https://app.wmvaa.id/ instead.
app.baseURL = 'https://app.wmvaa.id/wmvaa-akademia/'
app.indexPage = ''
app.appTimezone = 'Asia/Jayapura'
app.forceGlobalSecureRequests = true
app.CSPEnabled = true
app.allowedHostnamesCSV = 'app.wmvaa.id'

# Shared hosting normally does not require trusted proxy headers. Change this
# to true only when the hosting provider confirms an exact proxy IP/CIDR, then
# uncomment app.proxyIPsJSON. Never trust all addresses (0.0.0.0/0).
app.behindTrustedProxy = false
# app.proxyIPsJSON = '{"CHANGE_ME_PROXY_IP_OR_CIDR":"X-Forwarded-For"}'

cookie.secure = true
cookie.httponly = true
cookie.samesite = 'Lax'
cookie.path = '/'
session.cookieName = 'wmvaa_akademia_session'
# Default WRITEPATH/session is portable across cPanel/VPS. Ensure the complete
# writable directory is writable by the hosting PHP process.
# session.savePath = '/absolute/hosting/path/to/writable/session'
session.matchIP = false
session.timeToUpdate = 300
session.regenerateDestroy = true

security.csrfProtection = 'cookie'
security.tokenRandomize = true
security.cookieName = 'wmvaa_akademia_csrf'
security.regenerate = true
security.redirect = true
security.samesite = 'Lax'

contentsecuritypolicy.upgradeInsecureRequests = true
scheduling.teamTeachingEnabled = false
logger.threshold = 4

# Enter the exact database credentials created in cPanel/hosting. CodeIgniter
# does not expand ${DB_HOST}-style placeholders inside a .env file.
database.default.hostname = 'localhost'
database.default.database = 'CHANGE_ME_DATABASE'
database.default.username = 'CHANGE_ME_USERNAME'
database.default.password = 'CHANGE_ME_PASSWORD'
database.default.DBDriver = 'MySQLi'
database.default.port = 3306
database.default.DBDebug = false
database.default.charset = 'utf8mb4'
database.default.DBCollat = 'utf8mb4_general_ci'
database.default.strictOn = true
