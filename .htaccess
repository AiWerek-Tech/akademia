# ====================================================================
# WMVAA AKADEMIA - ROOT APACHE CONFIGURATION (.htaccess)
# ====================================================================

# Target PHP 8.2 in local XAMPP Apache without restarting
<If "%{HTTP_HOST} =~ /^(app\.wmvaa\.local|localhost|192\.168\.1\.62)$/ && %{REQUEST_URI} =~ /\.php/">
    SetEnv PHPRC "E:/xampp/php82"
    SetHandler application/x-httpd-php82
</If>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block direct access to storage, source, deployment files, and secrets.
    RewriteRule ^(?:writable|vendor|app|system|tests|deploy)(?:/|$) - [F,L,NC]
    RewriteRule ^(?:composer\.(?:json|lock)|phpunit\.xml\.dist|spark|env|\.env(?:\..*)?)$ - [F,L,NC]

    # 1. Rewrite empty requests to public/index.php
    RewriteRule ^$ public/index.php [L]

    # 2. Serve public assets in both supported hosting layouts:
    #    a) domain.tld/wmvaa-akademia/ (application in a subfolder), or
    #    b) domain.tld/ (document root points to the application directory).
    RewriteCond %{DOCUMENT_ROOT}/wmvaa-akademia/public/$1 -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/public/$1 -f
    RewriteRule ^(.*)$ public/$1 [L]

    # 3. Redirect semua request dinamis lainnya ke public/index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ public/index.php/$1 [L]
</IfModule>

# Menonaktifkan listing direktori
Options -Indexes

# Proteksi tipe MIME sniffing & security headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
