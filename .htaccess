# ====================================================================
# WMVAA AKADEMIA - ROOT APACHE CONFIGURATION (.htaccess)
# ====================================================================

# Target PHP 8.2 in local XAMPP Apache without restarting
<If "%{HTTP_HOST} =~ /^(app\.wmvaa\.local|localhost)$/ && %{REQUEST_URI} =~ /\.php/">
    SetEnv PHPRC "E:/xampp/php82"
    SetHandler application/x-httpd-php82
</If>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /wmvaa-akademia/

    # Block direct access to storage, writable, vendor, app, system, and sensitive configs
    RewriteRule ^(writable|vendor|app|tests|composer\.(json|lock)|phpunit\.xml\.dist|spark|\.env) - [F,L]

    # 1. Rewrite empty requests to public/index.php
    RewriteRule ^$ public/index.php [L]

    # 2. Jika file fisik yang diminta ada di dalam folder public/, layani langsung
    RewriteCond %{DOCUMENT_ROOT}/wmvaa-akademia/public/$1 -f
    RewriteRule ^(.*)$ public/$1 [L]

    # 3. Redirect semua request dinamis lainnya ke public/index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ public/index.php/$1 [L]
</IfModule>

# Menonaktifkan listing direktori
Options -Indexes

# Proteksi tipe MIME sniffing & security headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
